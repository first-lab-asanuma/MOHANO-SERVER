MOHANO_ENVIRONMENT=local
MOHANO_DATABASE_URL=mysql+pymysql://mohano:0000@127.0.0.1:3306/mohano?charset=utf8mb4
MOHANO_JWT_SECRET_KEY=replace-with-a-long-random-secret
MOHANO_ACCESS_TOKEN_EXPIRE_MINUTES=15
MOHANO_REFRESH_TOKEN_EXPIRE_DAYS=30
# Google Cloud Console에서 만든 Web application OAuth client ID입니다.
# ID token의 audience 검증에만 사용하며 client secret은 서버에도 저장하지 않습니다.
MOHANO_GOOGLE_WEB_CLIENT_ID=replace-with-your-web-client-id.apps.googleusercontent.com
MOHANO_CORS_ORIGINS_RAW=http://localhost:3000,http://localhost:8080
# Flutter web development ports are allowed by the local-only default regex in app/core/config.py.
# Override this value with explicit production origins before deployment.
MOHANO_CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$
# Local Silo defaults are configured in app/core/config.py. Set every value below only for a
# different local endpoint or the production Cloudflare R2 environment.
# MOHANO_OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
# MOHANO_OBJECT_STORAGE_PUBLIC_ENDPOINT=http://127.0.0.1:9000
# MOHANO_OBJECT_STORAGE_ACCESS_KEY=mohano
# MOHANO_OBJECT_STORAGE_SECRET_KEY=00000000
# MOHANO_OBJECT_STORAGE_BUCKET=mohano-profile-images
